{
  "manifest_version": 3,
  "name": "Work Log Manager",
  "version": "3.8.7",
  "description": "Work Log Manager V3.8.7 — Dashboard, Google Sheet, Excel Export, Edit, File Management, Soft Delete/Restore, Canonical Sheet Order, Fiscal Year",
  "permissions": [
    "identity",
    "storage",
    "system.display",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "{{client_id}}.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/drive"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "บันทึกการปฏิบัติงาน"
  },
  "options_page": "settings.html",
  "key": ""
}
